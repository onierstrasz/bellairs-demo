								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-02-04T10:43:38.169453+01:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "MR9auuJvRbSH6c3avRDBBw=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "*Title:* Applying Moldable Development to the Bellairs workshops\n\n*Abstract:*\nMoldable development is an approach to making software systems explainable by creating many tiny, contextual tools to the software to answer stakeholder questions. We demonstrate moldable development by applying it to the Bellairs workshop webpages, turning the static pages into an explorable and explainable model of the domain entities implicit in the web pages."
						}
					]
				},
