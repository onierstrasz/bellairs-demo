				"code" : "role := nil.\rworkshop := nil.\rworkshopTitle := ('<!-- all content &copy; ' asPParser\r\t\t, (' -->' asPParser not , #any asPParser) star flatten , ' -->' asPParser)\r\t\t==> [ :nodes | \r\t\t\tworkshop := nodes second trim.\r\t\t\tnil ].\rorganizerRole := '<h1>Organizers</h1>' asPParser trim\r\t\t==> [ :nodes | \r\t\t\trole := 'Organizer'.\r\t\t\tnil ].\rparticipantRole := '<h1>Confirmed Participants</h1>' asPParser trim\r\t\t==> [ :nodes | \r\t\t\trole := 'Participant'.\r\t\t\tnil ].\rperson := ('<!--' asPParser trim optional\r\t\t, '<li><a target=\"_committee\" href=\"' asPParser trim\r\t\t, ('https://' asPParser / 'http://' asPParser , $\" asPParser negate plus) flatten\r\t\t, '\">' asPParser , $< asPParser negate plus flatten\r\t\t, ('</a>' asPParser , $, asPParser optional) trim\r\t\t, $, asPParser negate plus flatten , ',' asPParser trim\r\t\t, $< asPParser negate plus flatten\r\t\t, ('</li>' asPParser trim , '-->' asPParser trim optional))\r\t\t==> [ :nodes | \r\t\t\t{'url' -> nodes third.\r\t\t\t\t'name' -> nodes fifth.\r\t\t\t\t'institution' -> nodes seventh.\r\t\t\t\t'country' -> nodes ninth} asDictionary ].\rpersonSimple := ('<li><a' asPParser not trim , '<li>' asPParser trim\r\t\t, $, asPParser negate plus flatten , $, asPParser trim\r\t\t, $, asPParser negate plus flatten , $, asPParser trim\r\t\t, $< asPParser negate plus flatten , '</li>' asPParser)\r\t\t==> [ :nodes | \r\t\t\t{'name' -> nodes third.\r\t\t\t\t'institution' -> nodes fifth.\r\t\t\t\t'country' -> nodes seventh} asDictionary ].\rignore := #any asPParser star ==> [ :nodes | nil ].\rbellairsLine := workshopTitle / organizerRole / participantRole / person\r\t\t/ personSimple / ignore"
